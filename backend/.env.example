PORT=5000
DB_PORT=3306
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=hotel_booking_db
# DB_SSL=true                  # Uncomment to require secure managed cloud database connections
# DB_SSL_CA_BASE64=            # Provide CA certificate as a Base64-encoded string if required by the cloud provider
JWT_SECRET=replace_with_a_private_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PAYMENTS_ENABLED=false
DEMO_PAYMENTS_ENABLED=false
# Email Configuration
# EMAIL_USER and EMAIL_PASS are required in production. Mock delivery is test-only.
EMAIL_USER=
# EMAIL_PASS must be a provider/app credential (e.g. Google App Password), not a normal account password
EMAIL_PASS=
# Phase 5 Email Outbox Configuration
EMAIL_WORKER_ENABLED=false
EMAIL_WORKER_INTERVAL_MS=5000
EMAIL_BATCH_SIZE=10
EMAIL_MAX_ATTEMPTS=3

# Dedicated 32-byte (64 hex characters) encryption key for securing outbox payloads.
# DO NOT USE THIS EXAMPLE KEY IN PRODUCTION. MUST BE 32 BYTES.
EMAIL_PAYLOAD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Frontend URL
# FRONTEND_URL is required and must be an HTTPS URL in production.
FRONTEND_URL=

# TRUST_PROXY: Configures Express "trust proxy" setting.
# - false (default): Use for direct connections or local development.
# - 1: Use when exactly one trusted reverse proxy (e.g. Render, NGINX) is in front.
# Production value must match the deployment topology.
TRUST_PROXY=false
CLIENT_URL=http://localhost:5173
APP_TIMEZONE=Asia/Colombo

# Phase 7B: Check-in Reminder Worker
# Set REMINDER_WORKER_ENABLED=true to activate the background scheduler.
# The worker is always disabled in NODE_ENV=test regardless of this flag.
REMINDER_WORKER_ENABLED=false
REMINDER_LEAD_DAYS=1
REMINDER_BATCH_SIZE=50
REMINDER_WORKER_INTERVAL_MS=3600000

# Phase 7B: Cron Endpoint Secret
# Required to call POST /api/v1/admin/cron/reminders.
# Provide a strong random value (>= 32 chars). Never commit the real value.
# CRON_SECRET=replace_with_a_strong_random_secret
